---
import MangaReaderLayout from "@layouts/MangaReaderLayout.astro";
import MangaReader from "@components/organisms/MangaReader.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { mangaConfig } from "@/config/mangaConfig";
import {
	getMangaBooks,
	type MangaBook,
	type MangaChapter,
} from "@/utils/manga-content";
import { url } from "@utils/url-utils";
export async function getStaticPaths() {
	if (!mangaConfig.enable) return [];
	return (await getMangaBooks()).flatMap((book) =>
		book.chapters.map((chapter, index) => ({
			params: {
				book_id: book.entry.data.book_id,
				chapter_id: chapter.data.chapter_id,
			},
			props: { book, chapter, index },
		})),
	);
}
interface Props {
	book: MangaBook;
	chapter: MangaChapter;
	index: number;
}
const { book, chapter, index } = Astro.props;
const data = chapter.data;
const labels = {
	settings: i18n(I18nKey.mangaSettings),
	fullscreen: i18n(I18nKey.mangaFullscreen),
	exitFullscreen: i18n(I18nKey.mangaExitFullscreen),
	reader: i18n(I18nKey.mangaReader),
	previous: i18n(I18nKey.mangaPrevious),
	next: i18n(I18nKey.mangaNext),
	mode: i18n(I18nKey.mangaMode),
	single: i18n(I18nKey.mangaSingle),
	double: i18n(I18nKey.mangaDouble),
	scroll: i18n(I18nKey.mangaScroll),
	direction: i18n(I18nKey.mangaDirection),
	rtl: i18n(I18nKey.mangaRtl),
	ltr: i18n(I18nKey.mangaLtr),
	page: i18n(I18nKey.mangaPage),
	pageAlt: i18n(I18nKey.mangaPageAlt),
	fitWidth: i18n(I18nKey.mangaFitWidth),
	fitHeight: i18n(I18nKey.mangaFitHeight),
	zoomIn: i18n(I18nKey.mangaZoomIn),
	zoomOut: i18n(I18nKey.mangaZoomOut),
	loading: i18n(I18nKey.mangaLoading),
	retry: i18n(I18nKey.mangaRetry),
	imageError: i18n(I18nKey.mangaImageError),
	progress: i18n(I18nKey.mangaProgress),
	chapters: i18n(I18nKey.mangaChapters),
	previousChapter: i18n(I18nKey.mangaPreviousChapter),
	nextChapter: i18n(I18nKey.mangaNextChapter),
};
const link = (n: number) =>
	book.chapters[n]
		? url(`/manga/${data.book_id}/${book.chapters[n].data.chapter_id}/`)
		: "";
---
<MangaReaderLayout title={`${data.title} · ${book.entry.data.title}`} description={data.description||book.entry.data.description}>
    <MangaReader client:load title={`${book.entry.data.title} · ${data.title}`} pages={data.pages} readingDirection={data.reading_direction} bookURL={url(`/manga/${data.book_id}/`)} bookId={data.book_id} chapterId={data.chapter_id} previousChapter={link(index-1)} nextChapter={link(index+1)} labels={labels}/>
</MangaReaderLayout>
