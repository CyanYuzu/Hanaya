---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import Card from "@components/atoms/display/Card.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { mangaConfig } from "@/config/mangaConfig";
import { getMangaBooks, type MangaBook } from "@/utils/manga-content";
import { url } from "@utils/url-utils";
import { render } from "astro:content";
import Markdown from "@components/content/Markdown.astro";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
export async function getStaticPaths() {
	if (!mangaConfig.enable) return [];
	return (await getMangaBooks()).map((book) => ({
		params: { book_id: book.entry.data.book_id },
		props: { book },
	}));
}
interface Props {
	book: MangaBook;
}
const { book } = Astro.props;
const data = book.entry.data;
const { Content, remarkPluginFrontmatter } = await render(book.entry);
const stylesheetAssets = await getMarkdownStylesheetAssets(
	remarkPluginFrontmatter.markdownSyntaxes,
);
---
<MainGridLayout title={data.title} description={data.description} ogImage={data.cover||undefined} page="manga">
    {stylesheetAssets.map(({pack,css})=><style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    <Card><article class="manga-book"><h1>{data.title}</h1><p>{data.author}</p><p>{data.description}</p>
        {data.cover&&<img src={data.cover} alt={data.title} width="300" height="400" loading="lazy" decoding="async"/>}
        <Markdown class="manga-introduction"><Content/></Markdown>
        <h2>{i18n(I18nKey.mangaChapters)}</h2>
        <ol>{book.chapters.map(chapter=><li><a class="m3-state-layer" href={url(`/manga/${data.book_id}/${chapter.data.chapter_id}/`)}>{chapter.data.title}</a><time datetime={chapter.data.published.toISOString()}>{chapter.data.published.toISOString().slice(0,10)}</time></li>)}</ol>
    </article></Card>
</MainGridLayout>
<style>
.manga-book{padding:var(--m3e-space-5);color:var(--mc-on-surface)}h1{font:var(--m3e-type-headline-md)}h2{font:var(--m3e-type-title-lg);margin-block:var(--m3e-space-4)}
img{max-width:18rem;width:100%;height:auto;border-radius:var(--shape-corner-l)}li{display:flex;align-items:center;gap:var(--m3e-space-3);border-block-end:1px solid var(--mc-outline-variant)}a{min-height:48px;display:flex;align-items:center;flex:1;padding:var(--m3e-space-3);border-radius:var(--shape-corner-m);color:var(--mc-primary)}time{color:var(--mc-on-surface-variant);font:var(--m3e-type-body-sm)}
</style>
