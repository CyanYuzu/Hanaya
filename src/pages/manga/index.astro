---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import Card from "@components/atoms/display/Card.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { mangaConfig } from "@/config/mangaConfig";
import { getMangaBooks } from "@/utils/manga-content";
import { url } from "@utils/url-utils";
if (!mangaConfig.enable) return Astro.redirect("/404/");
const books = await getMangaBooks();
---
<MainGridLayout title={i18n(I18nKey.manga)} description={i18n(I18nKey.mangaDescription)} page="manga">
    <h1 class="manga-title">{i18n(I18nKey.manga)}</h1>
    {books.length===0?<Card><p>{i18n(I18nKey.mangaEmpty)}</p></Card>:<div class="manga-catalogue">{books.map(({entry})=><Card><a class="manga-link m3-state-layer" href={url(`/manga/${entry.data.book_id}/`)}>
        {entry.data.cover&&<img src={entry.data.cover} alt={entry.data.title} width="300" height="400" loading="lazy" decoding="async"/>}
        <h2>{entry.data.title}</h2><p>{entry.data.author}</p><p>{entry.data.description}</p>
    </a></Card>)}</div>}
</MainGridLayout>
<style>
.manga-title{font:var(--m3e-type-headline-md);color:var(--mc-on-surface);margin-block-end:var(--m3e-space-4)}
.manga-catalogue{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr));gap:var(--m3e-space-4)}
.manga-link{display:block;color:var(--mc-on-surface);padding:var(--m3e-space-4);border-radius:var(--shape-corner-l)}
.manga-link img{width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;border-radius:var(--shape-corner-m)}
.manga-link h2{font:var(--m3e-type-title-lg);margin-block:var(--m3e-space-3)}
</style>
