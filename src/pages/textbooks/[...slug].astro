---
import { render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import { normalizeMarkdownCssClasses } from "@utils/markdown-css-classes";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getSourceMarkdownSyntaxSnapshot } from "@utils/markdown-source-syntaxes.mjs";
import {
	hasMarkdownSyntax,
	mergeMarkdownSyntaxSnapshots,
} from "@utils/markdown-syntaxes.mjs";
import {
	getTextbooks,
	getTextbookChapterUrl,
	getTextbookUrl,
} from "@utils/textbook-content";
import type { TextbookBook, TextbookChapter } from "@utils/textbook-content";
import { resolveI18nText } from "@utils/i18n-utils";
import { url } from "@utils/url-utils";
import { textbooksConfig } from "@/config/textbooksConfig";
import katexStylesheet from "katex/dist/katex.css?url";
import overlayScrollbarsStylesheet from "overlayscrollbars/overlayscrollbars.css?url";

interface Props {
	book: TextbookBook;
	chapter: TextbookChapter | null;
}

export async function getStaticPaths() {
	if (!textbooksConfig.enable) return [];

	const books = await getTextbooks();
	return books.flatMap((book) => [
		{
			params: { slug: book.slug },
			props: { book, chapter: null },
		},
		...book.chapters.map((chapter) => ({
			params: { slug: `${book.slug}/${chapter.slug}` },
			props: { book, chapter },
		})),
	]);
}

const { book, chapter } = Astro.props as Props;
const contentsLabel = resolveI18nText(
	"$t:textbookContents",
	I18nKey.textbookContents,
);
const backLabel = resolveI18nText("$t:textbooksBack", I18nKey.textbooksBack);
const bookTitle = book.title;
const bookDescription = book.entry.data.description;
const bookUrl = url(getTextbookUrl(book.slug));
const bookImage = book.entry.data.image || undefined;
const bookDate = book.entry.data.published
	? formatDateToYYYYMMDD(book.entry.data.published)
	: undefined;
const pageDescription = chapter
	? chapter.entry.data.description || bookDescription || bookTitle
	: bookDescription;

const rendered = chapter ? await render(chapter.entry) : undefined;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
let markdownStylesheetAssets: Array<{ pack: string; css: string }> = [];
let markdownClasses: string[] = [];
let hasMath = false;

if (chapter && rendered) {
	const renderedSyntaxes = rendered.remarkPluginFrontmatter.markdownSyntaxes;
	const sourceSyntaxes = hasMarkdownSyntax(
		renderedSyntaxes,
		"expressive-code",
	)
		? undefined
		: getSourceMarkdownSyntaxSnapshot(chapter.entry.body);
	const markdownSyntaxes = mergeMarkdownSyntaxSnapshots(
		renderedSyntaxes,
		sourceSyntaxes,
	);
	markdownClasses = normalizeMarkdownCssClasses(
		book.entry.data.cssclass,
		book.entry.data.cssclasses,
		chapter.entry.data.cssclass,
		chapter.entry.data.cssclasses,
	);
	markdownStylesheetAssets = await getMarkdownStylesheetAssets(
		markdownSyntaxes,
		markdownClasses,
	);
	hasMath = hasMarkdownSyntax(markdownSyntaxes, "math");
}

const pageTitle = chapter?.title ?? bookTitle;
---

<MainGridLayout
	title={pageTitle}
	banner={bookImage}
	ogImage={bookImage}
	description={pageDescription}
	bannerDate={bookDate}
	setOGTypeArticle={true}
	page={chapter ? "textbookChapter" : "textbooks"}
	{headings}
>
	{chapter && hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={katexStylesheet} />}
	{chapter && hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={overlayScrollbarsStylesheet} />}
	{chapter && markdownStylesheetAssets.map(({ pack, css }) => (
		<style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>
	))}
	{chapter ? (
		<article class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
			<Card variant="outlined" class="w-full px-6 py-6 md:px-9">
				<nav class="mb-5 text-sm text-[var(--on-surface-variant)]" aria-label={backLabel}>
					<a href={url("/textbooks/")}>{backLabel}</a>
					<span aria-hidden="true"> / </span>
					<a href={bookUrl}>{bookTitle}</a>
				</nav>
				<h1 class="mb-5 text-2xl font-bold text-[var(--on-surface)]">
					{chapter.title}
				</h1>
				<Markdown class={`mb-6 onload-animation ${markdownClasses.join(" ")}`}>
					{Content && <Content />}
				</Markdown>
			</Card>
		</article>
	) : (
		<section class="flex flex-col gap-4">
			<nav class="text-sm text-[var(--on-surface-variant)]" aria-label={backLabel}>
				<a href={url("/textbooks/")}>{backLabel}</a>
			</nav>
			<Card variant="outlined" class="w-full px-6 py-6 md:px-9">
				<h2 class="mb-4 text-xl font-semibold text-[var(--on-surface)]">
					{contentsLabel}
				</h2>
				{book.chapters.length > 0 ? (
					<ol class="flex flex-col gap-2">
						{book.chapters.map((item) => (
							<li>
								<a href={url(getTextbookChapterUrl(book.slug, item.slug))}>
									{item.title}
								</a>
							</li>
						))}
					</ol>
				) : (
					<p>{resolveI18nText("$t:textbooksEmpty", I18nKey.textbooksEmpty)}</p>
				)}
			</Card>
		</section>
	)}
</MainGridLayout>
