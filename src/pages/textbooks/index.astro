---
import Card from "@components/atoms/display/Card.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getTextbooks, getTextbookUrl } from "@utils/textbook-content";
import { resolveI18nText } from "@utils/i18n-utils";
import { url } from "@utils/url-utils";
import { textbooksConfig } from "@/config/textbooksConfig";

if (!textbooksConfig.enable) {
	return Astro.redirect("/404/");
}

const title = resolveI18nText(textbooksConfig.title, I18nKey.textbooks);
const description = resolveI18nText(
	textbooksConfig.description,
	I18nKey.textbooksBanner,
);
const books = await getTextbooks();
---

<MainGridLayout title={title} description={description} page="textbooks">
	<section class="flex flex-col gap-4" aria-label={title}>
		{books.length > 0 ? (
			books.map((book) => (
				<Card
					href={url(getTextbookUrl(book.slug))}
					variant="outlined"
					class="w-full px-5 py-4"
				>
					<div class="flex flex-col gap-2">
						<h2 class="text-xl font-semibold text-[var(--on-surface)]">
							{book.title}
						</h2>
						{book.entry.data.description && (
							<p class="text-[var(--on-surface-variant)]">
								{book.entry.data.description}
							</p>
						)}
					</div>
				</Card>
			))
		) : (
			<p class="text-[var(--on-surface-variant)]">
				{resolveI18nText("$t:textbooksEmpty", I18nKey.textbooksEmpty)}
			</p>
		)}
	</section>
</MainGridLayout>
